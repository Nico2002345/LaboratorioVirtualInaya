# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Si no se define DATABASE_URL, el backend usa SQLite local (desarrollo sin Docker).
# Para Postgres (docker-compose): postgres://labvirtual:labvirtual@db:5432/labvirtual
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Recuperación de contraseña: si EMAIL_HOST no está definido, los correos se
# imprimen en la consola del backend en vez de enviarse (útil en desarrollo).
# Ejemplo con Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True,
# EMAIL_HOST_USER=tucuenta@gmail.com, EMAIL_HOST_PASSWORD=<contraseña de aplicación>.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Laboratorio Virtual <no-reply@labvirtual.local>
# URL pública del frontend, usada para armar el enlace del correo de recuperación.
FRONTEND_URL=http://localhost:5173

# Postgres (usado por docker-compose)
POSTGRES_DB=labvirtual
POSTGRES_USER=labvirtual
POSTGRES_PASSWORD=labvirtual

# Frontend
VITE_API_URL=http://localhost:8000/api
